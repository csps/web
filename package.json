{
  "name": "csps-web",
  "private": true,
  "version": "2.0.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "b-dev": "bunx --bun vite --host",
    "b-build": "vue-tsc && bunx --bun vite build",
    "b-preview": "bunx --bun vite preview",
    "deploy": "bun run build && cp -r dist/* /var/www/csps"
  },
  "postcss": {
    "plugins": {
      "tailwindcss": {},
      "autoprefixer": {}
    }
  },
  "dependencies": {
    "@fancyapps/ui": "^5.0.36",
    "@material-symbols/svg-700": "^0.27.1",
    "@material/web": "^2.2.0",
    "@vercel/analytics": "^1.4.1",
    "animejs": "^3.2.2",
    "axios": "^1.7.7",
    "dayjs": "^1.11.13",
    "element-internals-polyfill": "^1.3.12",
    "file-saver": "^2.0.5",
    "pinia": "^2.2.6",
    "sal.js": "^0.8.5",
    "sweetalert2": "^11.14.5",
    "swiper": "^11.1.15",
    "typed.js": "^2.1.0",
    "uuid": "^11.0.3",
    "v-calendar": "^3.1.2",
    "vanilla-tilt": "^1.8.1",
    "vue": "^3.5.13",
    "vue-router": "^4.4.5",
    "vue3-toastify": "^0.2.4"
  },
  "devDependencies": {
    "@types/animejs": "^3.1.12",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^22.9.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "sass": "^1.81.0",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vite-bundle-analyzer": "^0.14.2",
    "vite-bundle-visualizer": "^1.2.1",
    "vue-tsc": "2.0.26"
  }
}
